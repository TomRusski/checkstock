# Скопируй в .env: cp .env.example .env
# Значения по умолчанию совпадают с docker-compose.yml — менять не обязательно.

# Порты, которые docker compose публикует НА ХОСТЕ.
# Выбраны нестандартные, чтобы не конфликтовать с локальными сервисами.
# Если порт занят — допиши сюда другое значение и перезапусти docker compose up -d.
DB_PORT=15432
APP_PORT=18080

# Строка подключения приложения.
# Внутри docker-сети хост называется "db" и порт 5432 (compose задаёт это сам).
# Здесь — вариант для запуска с хоста (WSL), порт = DB_PORT.
DATABASE_URL=postgresql+psycopg://checkstock:checkstock@localhost:15432/checkstock

# Отдельная база для тестов (создаётся автоматически, данные в ней удаляются).
# Если не задана — берётся DATABASE_URL с именем базы checkstock_test.
TEST_DATABASE_URL=postgresql+psycopg://checkstock:checkstock@localhost:15432/checkstock_test

# Засевать тестовые данные из ТЗ при старте, если база пустая.
SEED_ON_START=true

# Показывать SQL-запросы в логе (отладка).
SQL_ECHO=false
